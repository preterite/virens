#!/usr/bin/env zsh
# Disable a VIRENS module

# Source framework functions
if [ -f "$HOME/.virens" ]; then
    USER_INSTANCE=$(cat "$HOME/.virens")
    VIRENS_CONTAINER=$(dirname "$USER_INSTANCE")
    FRAMEWORK_DIR="$VIRENS_CONTAINER/virens"
else
    FRAMEWORK_DIR="$HOME/Local/virens/virens"
fi

source "$FRAMEWORK_DIR/engine/infrastructure/core/shell-functions.zsh"

MODULE=$1

if [ -z "$MODULE" ]; then
    echo "Usage: virens-disable <module-path>"
    echo ""
    echo "Currently enabled modules:"
    virens_list_modules
    exit 1
fi

USER_DIR=$(virens_user)
MODULES_FILE="$USER_DIR/config/modules.yaml"

if [ ! -f "$MODULES_FILE" ]; then
    echo "❌ modules.yaml not found: $MODULES_FILE"
    exit 1
fi

# Check if enabled
if ! grep -q "^  - $MODULE$" "$MODULES_FILE"; then
    echo "⚠️  Module not enabled: $MODULE"
    exit 0
fi

# Remove module (macOS-compatible sed)
sed -i '' "/^  - $MODULE$/d" "$MODULES_FILE"
echo "✅ Disabled module: $MODULE"
echo ""
echo "Restart your shell to apply changes:"
echo "  exec zsh"
