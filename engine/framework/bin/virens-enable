#!/usr/bin/env zsh
# Enable a VIRENS module

# Source framework functions
if [ -f "$HOME/.virens" ]; then
    USER_INSTANCE=$(cat "$HOME/.virens")
    VIRENS_CONTAINER=$(dirname "$USER_INSTANCE")
    FRAMEWORK_DIR="$VIRENS_CONTAINER/virens"
else
    FRAMEWORK_DIR="$HOME/Local/virens/virens"
fi

source "$FRAMEWORK_DIR/engine/infrastructure/core/shell-functions.zsh"

MODULE=$1

if [ -z "$MODULE" ]; then
    echo "Usage: virens-enable <module-path>"
    echo ""
    echo "Example: virens-enable observatory"
    echo "         virens-enable research/latex"
    echo ""
    echo "Available modules:"
    find "$FRAMEWORK_DIR/engine/framework/modules" -type d -mindepth 1 -maxdepth 2 | \
        sed "s|$FRAMEWORK_DIR/engine/framework/modules/||" | sort
    exit 1
fi

USER_DIR=$(virens_user)
MODULES_FILE="$USER_DIR/config/modules.yaml"

if [ ! -f "$MODULES_FILE" ]; then
    echo "❌ modules.yaml not found: $MODULES_FILE"
    exit 1
fi

# Check if already enabled
if grep -q "^  - $MODULE$" "$MODULES_FILE"; then
    echo "⚠️  Module already enabled: $MODULE"
    exit 0
fi

# Add module
echo "  - $MODULE" >> "$MODULES_FILE"
echo "✅ Enabled module: $MODULE"
echo ""
echo "Restart your shell to apply changes:"
echo "  exec zsh"
